{
  "description": "Design engineer, local mode: rules at session start, notes from the viewer, build + check after a turn. A no-op on the platform (ENGINEER_API) and outside a project whose .engineer/mode is local.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/local/bin/de-hook\" session-start",
            "timeout": 900
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/local/bin/de-hook\" user-prompt",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/local/bin/de-hook\" post-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/local/bin/de-hook\" stop",
            "timeout": 4500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/local/bin/de-hook\" pre-tool",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
